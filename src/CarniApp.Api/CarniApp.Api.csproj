  <ItemGroup>
    <ProjectReference Include="..\CarniApp.Application\CarniApp.Application.csproj" />
    <ProjectReference Include="..\CarniApp.Infrastructure\CarniApp.Infrastructure.csproj" />
  </ItemGroup>

</Project>
